# Auth (required) — generate a random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_a_long_random_secret

# Email settings (Gmail recommended — use an App Password, not your real password)
EMAIL_SENDER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_16_char_app_password
EMAIL_RECIPIENT=your_email@gmail.com

# Optional: SMTP settings (defaults to Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
